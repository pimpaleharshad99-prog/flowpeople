# ==============================================================================
# FLOWPEOPLE HRMS — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to `.env` (and `backend/.env` / `frontend/.env` as needed)
# and fill in your values.
# ==============================================================================

# Server & Security Configuration
PROJECT_NAME="FlowPeople — Complete Workforce Management (FlowCraft)"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite or PostgreSQL / Supabase)
# Default: Local SQLite database
DATABASE_URL="sqlite:///./hrms.db"

# PostgreSQL Direct Connection:
# DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# Supabase Transaction Pooler (recommended for FastAPI / Render serverless):
# DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Supabase Auth, Storage & API Credentials
# Retrieve from: Supabase Dashboard -> Project Settings -> API & JWT
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="[YOUR-ANON-PUBLIC-KEY]"
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY-SECRET]"
SUPABASE_JWT_SECRET="[YOUR-SUPABASE-JWT-SECRET]"
SUPABASE_JWKS=""

# Frontend Supabase Variables (for Vite frontend)
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="[YOUR-ANON-PUBLIC-KEY]"
VITE_SUPABASE_PUBLISHABLE_KEY="[YOUR-ANON-PUBLIC-KEY]"
VITE_API_URL="http://localhost:8000"

# Google Drive OAuth 2.0 Integration (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:8000/api/integrations/google-drive/callback"
GOOGLE_DRIVE_SCOPES="https://www.googleapis.com/auth/drive.file"
GOOGLE_OAUTH_ENABLED="false"

# Application URLs
FRONTEND_URL="http://localhost:5173"

# Company Policy Defaults
DEFAULT_WORK_HOURS_PER_DAY=8.0
DEFAULT_GRACE_PERIOD_MINS=15
DEFAULT_BREAK_DURATION_MINS=60
